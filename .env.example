# Copy to .env and fill in. Never commit .env.

# ---------- App ----------
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ---------- Database (Postgres + pgvector) ----------
# docker-compose overrides POSTGRES_HOST to `db` for the api container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vantage
POSTGRES_USER=vantage
POSTGRES_PASSWORD=change_me

# ---------- Embeddings ----------
# Embeddings stay local: this is a "private executive AI" demo, so document text
# is never sent to an embedding API. bge-m3 is multilingual and handles Thai.
# Pull it once:  docker compose exec ollama ollama pull bge-m3
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ---------- Generation ----------
# anthropic (default) | ollama. Only the *question* and the retrieved chunks go
# to the generation model; swap to ollama to keep everything on-premise.
GENERATION_BACKEND=anthropic
ANTHROPIC_API_KEY=
# Leave blank to hit the public Anthropic API; set to route via a gateway/proxy.
ANTHROPIC_BASE_URL=
API_MODEL=claude-sonnet-5
LOCAL_MODEL=qwen2.5:7b

# ---------- Tabular knowledge base (numbers come from SQL, never the LLM) ----------
SQL_KB_PATH=./data/kb.sqlite
SQL_KB_MAX_ROWS=50
SQL_KB_TIMEOUT_S=5.0

# ---------- Retrieval ----------
TOP_K_VECTOR=20
TOP_K_BM25=20
TOP_K_FINAL=5
RRF_K=60
CHUNK_SIZE=320
CHUNK_OVERLAP=48

# ---------- Reranker + refusal threshold ----------
# none | local. The relevance floor below is only meaningful for a
# cross-encoder ("local"), whose scores are comparable across queries.
RERANKER_TYPE=none
RERANKER_MODEL=bge-reranker-v2-m3
# Refuse ("ไม่พบข้อมูล") when the best retrieved chunk scores below this.
MIN_RELEVANCE_SCORE=
# Fallback floor on the fused RRF score, used when no cross-encoder ran. Keeps
# the refusal behaviour working with RERANKER_TYPE=none.
MIN_FUSED_SCORE=0.016

ENABLE_INJECTION_CHECK=true

# ---------- Data governance ----------
# Where the workspace/role policy lives. Deny-by-default for unknown roles.
POLICY_PATH=policy/policy.yaml
